# ============================================
# Enthalpix — .gitignore
# ============================================

# === Node / Frontend ===
node_modules/
.next/
out/
dist/
.vercel/
*.tsbuildinfo

# === Python / Backend ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# === Supabase ===
.supabase/

# === IDE & OS ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Test Artifacts ===
playwright-report/
test-results/
coverage/

# === Environment & Secrets ===
*.pem
*.key
.env
.env.*
.env.local
.env.production
!.env.example
!frontend/.env.example
!backend/.env.example

# === Generated Assets ===
# Keep ignored if fonts are auto-downloaded/generated during build
frontend/public/fonts/*.woff
frontend/public/fonts/*.woff2